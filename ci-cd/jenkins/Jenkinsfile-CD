pipeline {

    agent any

    parameters {
        string(
            name: 'APP_VERSION',
            defaultValue: '1.0.1',
            description: 'Version to deploy'
        )
    }

    environment {

        PROJECT_NAME = 'crm-dev'

        NEXUS_URL = 'http://YOUR-NEXUS-IP:8081'

        NEXUS_REPOSITORY = 'crm-dev-releases'

        DEPLOY_PATH = '/opt/crm-dev'

        APP_URL = 'http://localhost:5000'
    }

    stages {

        stage('Download Version') {

            steps {

                echo "Downloading version ${params.APP_VERSION} from Nexus..."

                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {

                    sh 'bash ci-cd/cd/download-artifact.sh'
                }
            }
        }

        stage('Deploy') {

            steps {

                echo "Deploying version ${params.APP_VERSION}..."

                sh 'bash ci-cd/cd/deploy.sh'
            }
        }

        stage('Health Check') {

            steps {

                echo "Checking application health..."

                sh 'bash ci-cd/cd/health-check.sh'
            }
        }
    }

    post {

        success {

            echo """
======================================
CD PIPELINE SUCCESS
======================================

Application : ${PROJECT_NAME}
Version     : ${params.APP_VERSION}
Nexus       : ${NEXUS_URL}

Deployment successful.

======================================
"""
        }

        failure {

            echo """
======================================
CD PIPELINE FAILED
======================================

Application : ${PROJECT_NAME}
Version     : ${params.APP_VERSION}

Deployment failed.

Check Jenkins console output.

======================================
"""
        }
    }
}