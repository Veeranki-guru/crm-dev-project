pipeline {

    agent any

    parameters {
        string(
            name: 'APP_VERSION',
            defaultValue: '1.0.1',
            description: 'Version to deploy'
        )
    }

    environment {

        PROJECT_NAME = 'crm-dev'

        NEXUS_URL = 'http://YOUR-NEXUS-IP:8081'

        NEXUS_REPOSITORY = 'crm-dev-releases'

        DEPLOY_PATH = '/opt/crm-dev'

        APP_URL = 'http://localhost:5000'
    }

    stages {

        stage('Download Version') {
            steps {

                echo "Downloading version ${params.APP_VERSION}..."

                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {

                    sh '''
                        export APP_VERSION="${APP_VERSION}"
                        export NEXUS_URL="${NEXUS_URL}"
                        export NEXUS_REPOSITORY="${NEXUS_REPOSITORY}"
                        export NEXUS_USER="${NEXUS_USER}"
                        export NEXUS_PASSWORD="${NEXUS_PASSWORD}"

                        bash ci-cd/cd/download-artifact.sh
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {

                sh '''
                    export APP_VERSION="${APP_VERSION}"
                    bash ci-cd/cd/deploy.sh
                '''
            }
        }

        stage('Health Check') {
            steps {

                sh '''
                    bash ci-cd/cd/health-check.sh
                '''
            }
        }
    }

    post {

        success {
            echo "======================================"
            echo "CD PIPELINE SUCCESS"
            echo "Application : ${PROJECT_NAME}"
            echo "Version     : ${params.APP_VERSION}"
            echo "======================================"
        }

        failure {
            echo "======================================"
            echo "CD PIPELINE FAILED"
            echo "Application : ${PROJECT_NAME}"
            echo "Version     : ${params.APP_VERSION}"
            echo "======================================"
        }
    }
}