pipeline {

    agent any

    parameters {
        string(
            name: 'APP_VERSION',
            defaultValue: '1.0.1',
            description: 'Version to deploy'
        )
    }

    environment {
        NEXUS_URL = 'http://localhost:8081'
        NEXUS_REPOSITORY = 'crm-dev-releases'
    }

    stages {

        stage('Download Artifact') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh "bash ci-cd/cd/download-artifact.sh ${params.APP_VERSION}"
                }
            }
        }

        stage('Deploy') {
            steps {
                sh "bash ci-cd/cd/deploy.sh ${params.APP_VERSION}"
            }
        }

        stage('Health Check') {
            steps {
                sh 'bash ci-cd/cd/health-check.sh'
            }
        }
    }

    post {
        success {
            echo "======================================"
            echo "CD PIPELINE SUCCESS"
            echo "Deployed Version: ${params.APP_VERSION}"
            echo "======================================"
        }

        failure {
            echo "CD PIPELINE FAILED"
        }
    }
}