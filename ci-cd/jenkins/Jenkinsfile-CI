pipeline {
    agent any

    parameters {
        string(
            name: 'APP_VERSION',
            defaultValue: '',
            description: 'Application version. Example: 1.0.3'
        )
    }

    environment {
        APP_NAME = 'crm-dev'

        NEXUS_URL = 'http://localhost:8081'
        NEXUS_REPOSITORY = 'crm-dev-releases'
        NEXUS_CREDENTIALS = 'nexus-credentials'

        SONAR_PROJECT_KEY = 'crm-dev'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Version') {
            steps {
                script {
                    if (!params.APP_VERSION?.trim()) {
                        error("APP_VERSION is required.")
                    }

                    if (!(params.APP_VERSION ==~ /^\d+\.\d+\.\d+$/)) {
                        error(
                            "Invalid APP_VERSION: ${params.APP_VERSION}. " +
                            "Expected format: 1.0.3"
                        )
                    }

                    env.VERSION = params.APP_VERSION

                    echo "Building version: ${env.VERSION}"
                }
            }
        }

        stage('Setup') {
            steps {
                sh '''
                    set -e

                    echo "Checking project structure..."

                    test -d backend || {
                        echo "ERROR: backend directory not found"
                        exit 1
                    }

                    test -d frontend || {
                        echo "ERROR: frontend directory not found"
                        exit 1
                    }

                    echo "Project structure validation successful."
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                    set -e

                    chmod +x ci-cd/ci/build.sh

                    ./ci-cd/ci/build.sh
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    set -e

                    if [ -x ci-cd/ci/test.sh ]; then
                        ./ci-cd/ci/test.sh
                    else
                        echo "WARNING: test.sh not found."
                        echo "Skipping automated tests."
                    fi
                '''
            }
        }

        stage('SonarQube Scan') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        set -e

                        sonar-scanner \
                          -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                          -Dsonar.projectName=${SONAR_PROJECT_KEY} \
                          -Dsonar.sources=backend,frontend \
                          -Dsonar.sourceEncoding=UTF-8
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Package Artifact') {
            steps {
                sh '''
                    set -e

                    chmod +x ci-cd/ci/artifact.sh

                    ./ci-cd/ci/artifact.sh "${VERSION}"
                '''
            }
        }

        stage('Upload to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${NEXUS_CREDENTIALS}",
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        ARTIFACT="crm-dev-${VERSION}.tar.gz"
                        ARTIFACT_PATH="${WORKSPACE}/${ARTIFACT}"

                        test -f "${ARTIFACT_PATH}" || {
                            echo "ERROR: Artifact not found: ${ARTIFACT_PATH}"
                            exit 1
                        }

                        echo "Uploading ${ARTIFACT} to Nexus..."

                        curl -f -u "${NEXUS_USER}:${NEXUS_PASSWORD}" \
                          --upload-file "${ARTIFACT_PATH}" \
                          "${NEXUS_URL}/repository/${NEXUS_REPOSITORY}/${ARTIFACT}"

                        echo "Artifact uploaded successfully."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "CI SUCCESS"
            echo "Artifact: crm-dev-${env.VERSION}.tar.gz"
        }

        failure {
            echo "CI FAILED"
        }

        always {
            archiveArtifacts(
                artifacts: 'crm-dev-*.tar.gz',
                allowEmptyArchive: true
            )
        }
    }
}