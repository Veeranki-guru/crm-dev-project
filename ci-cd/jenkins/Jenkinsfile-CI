pipeline {

    agent any

    environment {

        PROJECT_NAME = 'crm-dev'

        VERSION = "1.0.${BUILD_NUMBER}"

        NEXUS_URL = 'http://NEXUS_SERVER:8081'

        NEXUS_REPOSITORY = 'crm-dev-releases'

        NEXUS_CREDENTIALS = credentials('nexus-credentials')

    }

    stages {

        stage('Checkout') {

            steps {

                echo 'Checking out source code...'

                checkout scm

            }

        }

        stage('Setup') {

            steps {

                echo 'Setting up Python environment...'

                sh '''
                    chmod +x scripts/*.sh

                    ./scripts/setup.sh
                '''

            }

        }

        stage('Build') {

            steps {

                echo 'Building CRM application...'

                sh '''
                    ./scripts/build.sh
                '''

            }

        }

        stage('SonarQube Scan') {

            steps {

                echo 'Running SonarQube scan...'

                withSonarQubeEnv('sonarqube') {

                    sh '''
                        sonar-scanner \
                        -Dsonar.projectKey=crm-dev \
                        -Dsonar.projectName=crm-dev \
                        -Dsonar.sources=backend \
                        -Dsonar.tests=backend/tests
                    '''

                }

            }

        }

        stage('Test') {

            steps {

                echo 'Running tests...'

                sh '''
                    ./scripts/test.sh
                '''

            }

        }

        stage('Quality Gate') {

            steps {

                echo 'Checking SonarQube Quality Gate...'

                timeout(
                    time: 5,
                    unit: 'MINUTES'
                ) {

                    waitForQualityGate(
                        abortPipeline: true
                    )

                }

            }

        }

        stage('Version') {

            steps {

                echo "Creating version ${VERSION}"

                sh '''
                    echo "${VERSION}" > VERSION

                    cat VERSION
                '''

            }

        }

        stage('Package') {

            steps {

                echo 'Creating application package...'

                sh '''
                    ./scripts/package.sh
                '''

            }

        }

        stage('Push to Nexus') {

            steps {

                echo "Uploading version ${VERSION} to Nexus..."

                sh '''

                    PACKAGE=$(ls -t packages/*.tar.gz | head -n 1)

                    curl \
                    -u "$NEXUS_CREDENTIALS_USR:$NEXUS_CREDENTIALS_PSW" \
                    --upload-file "$PACKAGE" \
                    "$NEXUS_URL/repository/$NEXUS_REPOSITORY/crm-dev-${VERSION}.tar.gz"

                '''

            }

        }

    }

    post {

        success {

            echo """
            ======================================
            CI PIPELINE SUCCESS
            ======================================

            Project : ${PROJECT_NAME}
            Version : ${VERSION}

            Artifact uploaded to Nexus.

            ======================================
            """

        }

        failure {

            echo """
            ======================================
            CI PIPELINE FAILED
            ======================================

            Please check Jenkins console logs.

            ======================================
            """

        }

    }

}