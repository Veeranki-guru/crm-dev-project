pipeline {

    agent any

    environment {
        NEXUS_URL = 'http://YOUR-NEXUS-IP:8081'
        NEXUS_REPOSITORY = 'crm-dev-releases'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Generate Version') {
            steps {
                script {
                    env.APP_VERSION = "1.0.${BUILD_NUMBER}"
                    echo "Application Version: ${env.APP_VERSION}"
                }
            }
        }

        stage('Build') {
            steps {
                sh 'bash ci-cd/ci/build.sh'
            }
        }

        stage('Test QA') {
            steps {
                sh 'bash ci-cd/ci/test.sh'
            }
        }

        stage('SonarQube Scan') {
            steps {
                sh 'bash ci-cd/ci/sonar-scan.sh'
            }
        }

        stage('Quality Gate') {
            steps {
                sh 'bash ci-cd/ci/quality-gate.sh'
            }
        }

        stage('Package') {
            steps {
                sh 'bash ci-cd/ci/artifact.sh'
            }
        }

        stage('Upload to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh 'bash ci-cd/ci/upload-artifact.sh'
                }
            }
        }
    }

    post {
        success {
            echo "CI SUCCESS"
            echo "Version: ${APP_VERSION}"
        }
    }
}