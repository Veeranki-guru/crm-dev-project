pipeline {

    agent any

    environment {

        PROJECT_NAME = 'crm-dev'

        VERSION = "1.0.${BUILD_NUMBER}"

    }

    stages {

        stage('CI Pipeline') {

            steps {

                echo 'Starting CI Pipeline...'

                build job: 'crm-dev-CI'

            }

        }

        stage('CD Pipeline') {

            steps {

                echo 'CI Pipeline completed successfully.'

                echo 'Starting CD Pipeline...'

                build(
                    job: 'crm-dev-CD',
                    parameters: [
                        string(
                            name: 'APP_VERSION',
                            value: "${VERSION}"
                        )
                    ],
                    wait: true
                )

            }

        }

    }

    post {

        success {

            echo """
            ======================================
            CRM-DEV CI/CD SUCCESS
            ======================================

            CI completed successfully.
            CD completed successfully.

            Version: ${VERSION}

            ======================================
            """

        }

        failure {

            echo """
            ======================================
            CRM-DEV CI/CD FAILED
            ======================================

            Please check Jenkins console logs.

            ======================================
            """

        }

    }

}